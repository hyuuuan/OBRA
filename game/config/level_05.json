{
  "$comment": "Mayon: short ascent, active crater, twelve walkable memories, foreground shadow masks and the summit ending.",
  "schema_version": 1,
  "level_id": "level_5",
  "design_level_id": "L5_MAYON",
  "display_name": "Mayon",
  "order": 5,
  "goal": "Climb to the crater, walk through the places she remembers, and keep what you can.",
  "unlocks_on_complete": null,
  "unlocks_at_checkpoint": null,
  "tally": "majority",
  "tags_unlocked": [],
  "checkpoints": [
    {
      "id": "CP1",
      "at": "L5_CLIMB",
      "trigger": "area",
      "$comment": "At the crater rim; later memory departures replace CP1 silently."
    },
    {
      "id": "CP2",
      "at": "L5_SUMMIT",
      "trigger": "area",
      "$comment": "Beyond the memories, below the white summit. Silent."
    }
  ],
  "restrictions": {},
  "ink_economy": {
    "$comment": "Six units and no refills. Every drawing costs one (_every_drawing_costs_ink); a creature form drains 0.25 a second. hidden_reserve is never shown or mentioned: only the gates may draw on it, and only when the gauge cannot pay (_may_use_hidden_ink).",
    "capacity": 6,
    "creature_drain_per_second": 0.25,
    "hidden_reserve": 2,
    "reserve_pays_at": [
      "L5_SPAN",
      "L5_CLIMB"
    ]
  },
  "objectives": {
    "$comment": "Persistent, state-derived instructions. Key caps follow the current InputMap; no drawable answers are named.",
    "foot": "Head right. You have six ink and no refills.",
    "span": "{key:redraw}: draw a way across, then place it.",
    "climb": "{key:redraw}: draw a way up, then use it.",
    "slope": "Head right to the next rise.",
    "summit": "Walk right toward Lola and her painting.",
    "corridor": "Keep what you can. There is not ink for all of it.",
    "crater": "Jump into the crater to enter the memories.",
    "memories": "Keep walking. Memories you can save will glow.",
    "farewell": "{key:redraw}: raise the brush to Lolo.",
    "memory_near": "{key:redraw} to sketch and preserve this memory.",
    "memory_saved": "Memory preserved. Keep walking right when ready.",
    "memory_lost": "This memory is gone. Keep walking right.",
    "memory_empty": "No ink left. You can still walk right to the ending.",
    "farewell_going": "Stay with Lolo until his words end.",
    "summit_try": "{key:redraw}: draw Lola on the page.",
    "summit_again": "{key:redraw}: try drawing Lola once more.",
    "summit_lowering": "Let the brush rest for a moment.",
    "summit_places": "{key:redraw}: draw a place you remember. Any drawing works.",
    "summit_blooming": "Your drawing is finished. Watch the places return.",
    "complete": "Mayon complete. Progress saved. Returning home."
  },
  "obstacles": [
    {
      "id": "L5_SPAN",
      "type": "tutorial",
      "dialogue_node": false,
      "fail_state": false,
      "sub_beats": [
        {
          "id": "way_across",
          "teaches": "span",
          "required_tags": [
            "span"
          ],
          "exclude": [
            "circle",
            "square",
            "triangle"
          ],
          "$comment": "The bridge she came up by drained white, then blank. 300 px across: past a running jump (228), under a bridge (340). A drawn primitive is 80 px and spans nothing here, so the shapes are excluded and span is a bridge or a ladder laid over."
        }
      ],
      "$comment": "A gate the climb cannot be finished without: payable from the hidden reserve."
    },
    {
      "id": "L5_CLIMB",
      "type": "tutorial",
      "dialogue_node": false,
      "fail_state": false,
      "sub_beats": [
        {
          "id": "way_up",
          "teaches": "climb",
          "required_tags": [
            "climb"
          ],
          "exclude": [
            "crab"
          ],
          "$comment": "The path thinned out to a wall 220 high: over a primitive and a jump (174), under stairs and a jump (270). crab is out, as at Payyo's stair: it needs a wall to cling to and gets nowhere on one this short."
        }
      ],
      "$comment": "The other gate the climb cannot be finished without."
    },
    {
      "id": "L5_SUMMIT",
      "type": "tutorial",
      "dialogue_node": false,
      "fail_state": false,
      "sub_beats": [],
      "$comment": "Where the summit begins, so CP2 has a beat to stand at. Its ending sequence is owned by level_5.gd."
    }
  ],
  "hidden_flowers": [
    {
      "id": "L5_HF",
      "at": "dilim_dawn",
      "awarded_by": "artist",
      "not_a_fail_state": true,
      "$comment": "The fragment nobody needed: a flower lola painted for no reason. Saved by spending ink on its optional memory fragment."
    }
  ],
  "recognition": {
    "confidence_threshold": 0.6,
    "margin_threshold": 0.15,
    "acceptance_threshold": 0.75,
    "eases_after_declines": 2,
    "ease_step": 0.05,
    "$comment_acceptance": "The 0.60 / 0.15 floor never moves. acceptance_threshold is the level's own bar above it (thesis 4.5.4.2), raised only once the new brush from Dagat is in hand; after eases_after_declines declines in a row it falls by ease_step per decline to the floor. See SketchClient. Mayon: the last painting; the new brush asks the most.",
    "decline_costs_ink": false,
    "decline_message_source": "dialogue"
  },
  "load_time_assertions": [
    "every gate resolves >= 2 classes after exclusions, each at or above 0.70 held-out recall (BR-7)",
    "the span is wider than a running jump and narrower than a bridge; the wall is higher than a primitive and a jump and lower than stairs and a jump",
    "no refill anywhere: no jar, no clearing, no refilled_at",
    "checkpoints are silent",
    "no health and nothing that fights",
    "no dialogue line names a drawable class"
  ],
