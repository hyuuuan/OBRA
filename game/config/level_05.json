  "restrictions": {},
  "ink_economy": {
    "$comment": "Six units and no refills. Every drawing costs one (_every_drawing_costs_ink); a creature form drains 0.25 a second. hidden_reserve is never shown or mentioned: only the gates may draw on it, and only when the gauge cannot pay (_may_use_hidden_ink).",
    "capacity": 6,
    "creature_drain_per_second": 0.25,
    "hidden_reserve": 2,
    "reserve_pays_at": [
      "L5_SPAN",
      "L5_CLIMB"
    ]
  },
  "objectives": {
    "$comment": "In Lolo's voice while he climbs with her, short enough for the banner (720 px), naming no class.",
    "foot": "Climb, apo. Mind the ink -- there is no more of it up here.",
    "span": "The way across is gone. Make one.",
    "climb": "The path has thinned to nothing. Make a way up.",
    "slope": "Keep climbing.",
    "summit": "Keep climbing.",
    "corridor": "Keep what you can. There is not ink for all of it."
  },
  "obstacles": [
    {
      "id": "L5_SPAN",
      "type": "tutorial",
      "dialogue_node": false,
      "fail_state": false,
      "sub_beats": [
        {
          "id": "way_across",
          "teaches": "span",
          "required_tags": [
            "span"
          ],
          "exclude": [
            "circle",
            "square",
            "triangle"
          ],
          "$comment": "The bridge she came up by drained white, then blank. 300 px across: past a running jump (228), under a bridge (340). A drawn primitive is 80 px and spans nothing here, so the shapes are excluded and span is a bridge or a ladder laid over."
        }
      ],
      "$comment": "A gate the climb cannot be finished without: payable from the hidden reserve."
    },
    {
      "id": "L5_CLIMB",
      "type": "tutorial",
      "dialogue_node": false,
      "fail_state": false,
      "sub_beats": [
        {
          "id": "way_up",
          "teaches": "climb",
          "required_tags": [
            "climb"
          ],
          "exclude": [
            "crab"
          ],
          "$comment": "The path thinned out to a wall 220 high: over a primitive and a jump (174), under stairs and a jump (270). crab is out, as at Payyo's stair: it needs a wall to cling to and gets nowhere on one this short."
        }
      ],
      "$comment": "The other gate the climb cannot be finished without."
    },
    {
      "id": "L5_SUMMIT",
      "type": "tutorial",
      "dialogue_node": false,
      "fail_state": false,
      "sub_beats": [],
      "$comment": "Where the summit begins, so CP2 has a beat to stand at. Its ending sequence is owned by level_5.gd."
    }
  ],
  "hidden_flowers": [
