      "id": "B0_HAGDAN",
      "type": "tutorial",
      "dialogue_node": false,
      "fail_state": false,
      "sub_beats": [
        {
          "id": "sub1",
          "teaches": "roll",
          "required_tags": [
            "roll"
          ],
          "exclude": [],
          "$comment": "The paddy, and it comes first because it is what the player meets first. Three hundred pixels of water, and nothing 80px wide spans that -- so the crossing is the plank already floating in it: weigh it down with something that rolls and it lies flat, steadies and becomes a step. Span used to be asked here and could not be answered, because the only class long enough to reach across is the one this beat excludes."
        },
        {
          "id": "sub2",
          "teaches": "span",
          "required_tags": [
            "span"
          ],
          "exclude": [
            "bridge",
            "ladder"
          ],
          "$comment": "The stair, past the water: a 136px rise against a 94.3px jump with three treads missing. A drawn primitive is 80px, which is a step -- so bridge and ladder are excluded here to keep the answer a thing you build up to rather than a thing you lay across."
        }
      ],
      "scripted": {
        "on_first_decline": "L1_B0_006"
      }
    },
