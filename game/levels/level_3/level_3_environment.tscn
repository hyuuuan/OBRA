[node name="Ambience" type="Node2D" parent="WorldCamera"]
script = ExtResource("4_ambience")

; Behind every band, above the waterline. The shore's sky plate is 941 tall and the world
; goes higher than that, so this is the plate's own top row -- a band of a different blue over
; the painted sky was the first thing a flying morph would have seen.
[node name="SkyFill" type="Polygon2D" parent="."]
z_index = -300
color = Color(0.141, 0.565, 0.953, 1)
polygon = PackedVector2Array(-3000, -3000, 9000, -3000, 9000, 560, -3000, 560)

; Behind the painted column, and below it: the deep band is 941 tall and the world goes on
; past that. The water plate's own bottom row, so where the two meet there is no seam.
[node name="DeepFill" type="Polygon2D" parent="."]
z_index = -290
color = Color(0.004, 0.106, 0.275, 1)
polygon = PackedVector2Array(-3000, 560, 9000, 560, 9000, 2600, -3000, 2600)

; ⚠ plate_top = 560 - 790. The sand's surface sits at plate-y 790 in the delivered art and
; the apo stands on world y 560, so the plate's top edge goes at -230 and every layer in the
; band is pinned by that same edge. Derived from the art, not chosen -- see
; dagat_backdrop_2d.gd, and re-measure with the snippet in LEVEL_3.md if the art is redrawn.
; The daylight sky and sea run the WHOLE level: it is what the storm gathers over and what is
; left when it clears. Only the sand and palms stop, at the ends of the land.
[node name="ShoreBand" type="Node2D" parent="."]
script = ExtResource("10_backdrop")
band = "shore"
depth = 2.0
span = Vector2(-400.0, 5700.0)
plate_top = -230.0
home_ground = Vector2(100.0, 1000.0)
island_ground = Vector2(4500.0, 5380.0)
night_span = Vector2(1600.0, 3000.0)
night_tint = Color(0.42, 0.5, 0.72, 1)
far_fade_span = Vector2(1000.0, 1560.0)
night_span = Vector2(1600.0, 3000.0)
night_tint = Color(0.60, 0.66, 0.85, 1)

; ⚠ plate_top = 560, THE WATERLINE ITSELF, AND floor_drop = 360 UNDER IT. The water is
; pinned by its top -- the painted column starts where the sea starts, and its light comes from
; there. The floor is not: the delivered picture puts its seabed 789 under the surface, less
; than a screen, so from the boat the ruins stood just under the keel and the beach, the sea and
; the seabed were all one picture. The floor layers drop 360, landing the seabed at
; 560 + 360 + 789 = 1709, and the collision, the refills and the coral field follow it --
; level_3.gd's BED_Y is that number, and run_level3_audit checks the two agree.
[node name="DeepBand" type="Node2D" parent="."]
script = ExtResource("10_backdrop")
band = "deep"
depth = 1.0
span = Vector2(940.0, 4530.0)
plate_top = 560.0
floor_drop = 360.0
night_span = Vector2(1600.0, 3000.0)
night_tint = Color(0.55, 0.62, 0.82, 1)

; ⚠ plate_top = 560 - 664: THE FRONT WAVE, NOT THE HORIZON. The storm plate is a sea seen
; from the side, receding from a foreground crest at plate-y ~664 up to a horizon at ~467.
; It was pinned at 421 -- above the horizon -- so the boat rode along the skyline with two
; hundred pixels of painted waves hanging under its keel and the jetty's posts drowned under
; them. A side view floats on the nearest wave; everything above it is the sea going away.
; ⚠ 1000..1560, WHERE THE PLAYER LEAVES THE SAND, AND NOT 1600..3000. This is a change of
; VIEWPOINT, not of weather: this sea seen from the side replaces the beach's sea seen from the
; front. Cross-faded over fourteen hundred pixels -- with the shore band, which carries the
; island, never leaving at all -- the whole first third of the crossing was two horizons at two
; heights with two sets of waves between them. The shore band's far_fade_span is the same
; stretch, reversed, so exactly one sea is ever being looked at.
; night_span 1600..3000 is the other half of it: the LIGHT going, which is the buildup the
; design asks for -- "darker and emptier as the player nears the bakunawa". weather_at() reads
; this one, so the rain, the lightning and the gulls keep the timing they were tuned with.
[node name="StormBand" type="Node2D" parent="."]
script = ExtResource("10_backdrop")
band = "storm"
depth = 1.5
span = Vector2(1150.0, 5700.0)
plate_top = -104.0
headland_x = 2600.0
far_island_x = 4450.0
sky_colour = Color(0.055, 0.149, 0.259, 1)
sky_bottom_row = 470.0
fade_span = Vector2(1000.0, 1560.0)

