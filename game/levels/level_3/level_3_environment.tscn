; ⚠ y IS THE BOTTOM OF THIS ONE, NOT ITS MIDDLE. DialogueNode2D anchors its box at
; -trigger_size.y * 0.5, so the volume climbs from the node rather than straddling it --
; unlike LevelObstacle2D and CheckpointArea2D, which centre theirs. At 1060 it covered
; -190..1060 and a diver at 1150 swam under the fork without being asked anything.
[node name="BakunawaNode" type="Area2D" parent="GameplayPlane"]
position = Vector2(3560.0, 1810.0)
script = ExtResource("7_dialoguenode")
level_id = "level_3"
trigger_size = Vector2(160.0, 1500.0)
