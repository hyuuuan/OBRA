[node name="Ambience" type="Node2D" parent="WorldCamera"]
script = ExtResource("4_ambience")

; Behind every band, above the waterline. The shore's sky plate is 941 tall and the world
; goes higher than that, so this is the plate's own top row -- a band of a different blue over
; the painted sky was the first thing a flying morph would have seen.
[node name="SkyFill" type="Polygon2D" parent="."]
z_index = -300
color = Color(0.141, 0.565, 0.953, 1)
polygon = PackedVector2Array(-3000, -3000, 9000, -3000, 9000, 560, -3000, 560)

; Behind the painted column, and below it: the deep band is 941 tall and the world goes on
; past that. The water plate's own bottom row, so where the two meet there is no seam.
[node name="DeepFill" type="Polygon2D" parent="."]
z_index = -290
color = Color(0.004, 0.106, 0.275, 1)
polygon = PackedVector2Array(-3000, 560, 9000, 560, 9000, 2600, -3000, 2600)

; ⚠ PLACEHOLDER TERRAIN, AND IT IS THE SHAPE THAT MATTERS, NOT THE COLOUR. The shore, the
; seabed and the island were collision boxes with nothing drawn on them, so the level ran
; correctly and photographed as an empty blue field: no sand to stand on, no bed to swim
; over, no far side to arrive at. These polygons trace the SAME rectangles the StaticBody2D
; shapes use, so when the painted art lands it has the footprint to sit in. Drawn behind the
; gameplay plane so nothing here covers the player, Lolo or the creature.
[node name="Terrain Fills" type="Node2D" parent="."]
z_index = -180

[node name="IslandFill" type="Polygon2D" parent="Terrain Fills"]
color = Color(0.84, 0.76, 0.57, 1)
polygon = PackedVector2Array(4500, 560, 5400, 560, 5400, 800, 4500, 800)

; ⚠ plate_top = 560 - 790. The sand's surface sits at plate-y 790 in the delivered art and
; the apo stands on world y 560, so the plate's top edge goes at -230 and every layer in the
; band is pinned by that same edge. Derived from the art, not chosen -- see
; dagat_backdrop_2d.gd, and re-measure with the snippet in LEVEL_3.md if the art is redrawn.
[node name="ShoreBand" type="Node2D" parent="."]
script = ExtResource("10_backdrop")
band = "shore"
depth = 2.0
span = Vector2(-400.0, 1400.0)
plate_top = -230.0
home_ground = Vector2(100.0, 1000.0)
fade_span = Vector2(1400.0, 1150.0)

; ⚠ plate_top = 560, THE WATERLINE ITSELF. Unlike the shore, this band is pinned by its TOP
; rather than by a feature inside it -- the painted column starts where the sea starts. Its
; own floor then lands at 560 + 789 = 1349, which is where the seabed collision was moved to
; rather than stretching the art to meet the collision: a 1.27x vertical scale on pixel art
; to save moving one StaticBody2D is the wrong trade.
[node name="DeepBand" type="Node2D" parent="."]
script = ExtResource("10_backdrop")
band = "deep"
depth = 1.0
span = Vector2(940.0, 4530.0)
plate_top = 560.0

; ⚠ plate_top = 560 - 421. The storm's own wave surface sits at plate-y 421 and the sea is
; at world 560, so this band is pinned by ITS waterline the way the shore is pinned by its
; sand. Faded up across the crossing rather than butted against the daylight band: the design
; asks that the field darken as the player nears the encounter.
[node name="StormBand" type="Node2D" parent="."]
script = ExtResource("10_backdrop")
band = "storm"
depth = 1.5
span = Vector2(1150.0, 4560.0)
plate_top = 139.0
headland_x = 2350.0
far_island_x = 4450.0
fade_span = Vector2(1200.0, 2700.0)

