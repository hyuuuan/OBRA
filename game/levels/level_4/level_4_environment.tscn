[node name="Terrain" type="Node2D" parent="GameplayPlane"]

; One floor the whole way, broken where an encounter's ground needs it: the drop by the tiyanak's
; cry (17250-17550, 300 wide -- past a running jump's 228). Its other ground -- the forks, the
; ravine, the high path -- comes with each encounter.
[node name="Ground" type="StaticBody2D" parent="GameplayPlane/Terrain"]
script = ExtResource("8_terrain")
platforms = Array[Rect2]([Rect2(-200, 600, 17450, 800), Rect2(17550, 600, 5050, 800)])

; ⚠ THE CANOPY IS A CEILING, NOT A RULE (Kent's design: 'the canopy block flight physically').
; 440 up: higher than a drawn tree reaches (362), so every way over the ground still fits under
; it, and a flier meets leaves instead of a refusal. run_level4_audit holds it over every beat.
; A rock in the sigbin's ground, waist-high: she can jump it (94 px), it cannot climb it (48), so
; with her back to it nothing can get behind her.
[node name="SigbinRock" type="StaticBody2D" parent="GameplayPlane/Terrain"]
script = ExtResource("8_terrain")
platforms = Array[Rect2]([Rect2(6700, 530, 90, 70)])
body = "stone"

; The tikbalang's landmark rock -- the one the paths keep coming back to -- and the fork: the
; ground below, and branches she can jump up through above. Both run on to the same place.
[node name="LandmarkRock" type="StaticBody2D" parent="GameplayPlane/Terrain"]
script = ExtResource("8_terrain")
platforms = Array[Rect2]([Rect2(8230, 560, 70, 40)])
body = "stone"

[node name="Fork" type="StaticBody2D" parent="GameplayPlane/Terrain"]
script = ExtResource("8_terrain")
branches = Array[Rect2]([Rect2(8650, 520, 220, 18), Rect2(8950, 450, 260, 18), Rect2(9300, 470, 260, 18)])

; THE PATH OVER THE TIYANAK'S DROP (Kent's design: "stay on the path and do not approach"). Logs
; she steps up onto -- 70 then 65 px, each a jump -- and walks along over the drop, down again past
; it. Down on the ground under them is the cry, and the bushes run on over nothing.
[node name="TiyanakPath" type="StaticBody2D" parent="GameplayPlane/Terrain"]
script = ExtResource("8_terrain")
branches = Array[Rect2]([Rect2(16900, 530, 220, 18), Rect2(17080, 465, 600, 18)])

