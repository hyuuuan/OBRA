texture = ExtResource("p_old_steps")

[node name="PalesPalm" type="Sprite2D" parent="GameplayPlane/AshTakes" groups=["ash_takes"]]
texture_filter = 1
position = Vector2(3250.0, 382.0)
texture = ExtResource("p_palm_short")
metadata/taken_at = 2900.0
metadata/taken_over = 6.0

; The flower remains above the path: detached one-way rocks can be climbed or passed beneath.
; Nothing on this optional detour is needed to reach the summit.
; ⚠ THREE 60px RISES, 180px APART. Four 80px rises left a 14px margin on a 94px jump that a
; released key cuts short, and a player running right missed the whole stair on most jump
; timings. This spacing catches every timing of a run-and-jump from the -340 shelf (modelled
; frame by frame against wanderer.gd). The flower sits 120px over the top rock: in reach from
; it alone -- 180px from the rock below, 210px from the path.
[node name="FlowerLedge" type="StaticBody2D" parent="GameplayPlane/Terrain"]
script = ExtResource("8_terrain")
platforms = Array[Rect2]([Rect2(9760, -400, 220, 30), Rect2(9940, -460, 220, 30), Rect2(10120, -520, 220, 30)])
grassed = false
one_way = true

