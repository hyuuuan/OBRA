[node name="WorldCamera" type="Camera2D" parent="."]
script = ExtResource("2_camera")
target_offset = Vector2(0, -260)
world_bottom_y = 900.0
outdoor_x_limits = Vector2(116, 13880)

; The ash, hung on the camera: thicker the higher she climbs (level_5.gd sets the density).
[node name="Ash" type="Node2D" parent="WorldCamera"]
script = ExtResource("4_ash")
density = 0.25

; Behind every band: the sunset's own colour, so a camera past a plate's edge meets more sky.
[node name="SkyFill" type="Polygon2D" parent="."]
z_index = -300
color = Color(0.933, 0.533, 0.247, 1)
polygon = PackedVector2Array(-3000, -4000, 20000, -4000, 20000, 3000, -3000, 3000)

 ; The registered painting stays together. The high slope cross-fades in as she climbs.
[node name="SkyBand" type="Node2D" parent="."]
z_index = -100
script = ExtResource("7_backdrop")

[node name="GameplayPlane" type="Node2D" parent="."]
script = ExtResource("3_depth")

[node name="EntityRoot" type="Node2D" parent="GameplayPlane"]

