[node name="Terrain" type="Node2D" parent="GameplayPlane"]

; THE CLIMB. Each step rises 80 -- under a jump's 94 -- except at the two gates: the span
; (2300-2600, 300 across: past a running jump's 228, under a bridge's 340) and the wall at 4200
; (220 up: over a primitive and a jump's 174, under stairs and a jump's 270). Each gate has
; 500 px or more of floor before it (R7). run_level5_audit reads these rectangles.
[node name="Slopes" type="StaticBody2D" parent="GameplayPlane/Terrain"]
script = ExtResource("8_terrain")
platforms = Array[Rect2]([Rect2(-200, 600, 1600, 800), Rect2(1400, 520, 400, 880), Rect2(1800, 440, 500, 960), Rect2(2600, 440, 900, 960), Rect2(3500, 360, 700, 1040)])

; Above the treeline nothing grows: the bare cone, the corridor and the summit.
[node name="Cone" type="StaticBody2D" parent="GameplayPlane/Terrain"]
script = ExtResource("8_terrain")
platforms = Array[Rect2]([Rect2(4200, 140, 1200, 1260), Rect2(5400, 60, 600, 1340), Rect2(6000, -20, 500, 1420), Rect2(6500, -100, 1300, 1500), Rect2(7800, -180, 500, 1580), Rect2(8300, -260, 1300, 1660), Rect2(9600, -340, 500, 1740), Rect2(10100, -420, 3900, 1820)])
grassed = false
tint = Color(0.8, 0.76, 0.74, 1)

; ACT ONE, DRESSED: the Cagsawa bell tower at the foot (Mayon's own ruin), palms, lava rocks and
; ferns up the treeline. Behind the play, never in front of it.
